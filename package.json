{
  "name": "youtube-audio-server",
  "version": "3.0.0",
  "description": "Easily stream and download audio from YouTube.",
  "keywords": [
    "youtube",
    "audio",
    "mp3",
    "stream",
    "yt-dlp",
    "ffmpeg"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "yas": "./src/bin.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/bin.js",
    "lint": "eslint .",
    "test": "npm run lint && node --test test/*.test.js",
    "test:live": "YAS_LIVE=1 node --test test/live.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codealchemist/youtube-audio-server.git"
  },
  "author": "Alberto Miranda",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/codealchemist/youtube-audio-server/issues"
  },
  "homepage": "https://github.com/codealchemist/youtube-audio-server#readme",
  "dependencies": {
    "express": "^5.3.0",
    "sanitize-filename": "^1.6.4"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "neostandard": "^0.14.1"
  }
}
